APP_NAME="Zakat Annur"
APP_ENV=production
APP_KEY=base64:ISI_DARI_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://domain-anda.com
ASSET_URL=
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE_HOSTING
DB_USERNAME=ISI_USERNAME_DATABASE_HOSTING
DB_PASSWORD=ISI_PASSWORD_DATABASE_HOSTING

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=60
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=domain-anda.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=ISI_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=ISI_SMTP_USERNAME
MAIL_PASSWORD=ISI_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domain-anda.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_VERIFY_TLS=true

CHATBOT_PROVIDER=openai
OPENAI_API_KEY=ISI_OPENAI_API_KEY
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_PREMIUM_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

ZAKAT_TIMEZONE=Asia/Jakarta
ZAKAT_PURGE_DAYS=30
ZAKAT_ENABLE_AUTO_PURGE=true
ZAKAT_AUDIT_ENABLED=true

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false
